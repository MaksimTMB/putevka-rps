@echo off
chcp 65001 >nul
setlocal
title Установщик Десктопного Приложения АСУ ПУТЁВКА v6.6.0 (Windows)

set "INSTALL_DIR=%LocalAppData%\Programs\PutevkaApp"
if not "%~1"=="" set "INSTALL_DIR=%~1"

echo ==================================================================
echo   АСУ «ПУТЁВКА» v6.6.0 — Установка Десктопного Приложения Windows
echo   Папка установки: %INSTALL_DIR%
echo ==================================================================

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$selfPath = '%~f0';" ^
  "$targetDir = '%INSTALL_DIR%';" ^
  "Write-Host '[INFO] Распаковка приложения в ' $targetDir -ForegroundColor Cyan;" ^
  "$lines = [System.IO.File]::ReadAllLines($selfPath);" ^
  "$idx = [Array]::IndexOf($lines, '::PAYLOAD_BEGIN::');" ^
  "if ($idx -lt 0) { throw 'Payload marker not found' };" ^
  "$b64 = [string]::Join('', $lines[($idx + 1)..($lines.Length - 1)]);" ^
  "$bytes = [Convert]::FromBase64String($b64);" ^
  "$tmpZip = Join-Path $env:TEMP 'putevka_desktop_v66_sfx.zip';" ^
  "[System.IO.File]::WriteAllBytes($tmpZip, $bytes);" ^
  "if (-not (Test-Path $targetDir)) { New-Item -ItemType Directory -Path $targetDir -Force | Out-Null };" ^
  "Expand-Archive -Path $tmpZip -DestinationPath $targetDir -Force;" ^
  "Remove-Item $tmpZip -Force -ErrorAction SilentlyContinue;" ^
  "Write-Host '[ OK ] Файлы приложения распакованы!' -ForegroundColor Green;" ^
  "& (Join-Path $targetDir 'scripts_win\install_desktop_app.ps1') -BuildExe"

echo.
pause
exit /b 0
